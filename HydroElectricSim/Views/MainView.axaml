<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:HydroElectricSim.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="HydroElectricSim.Views.MainView"
             x:DataType="vm:MainViewModel">
    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="2*"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto">
                <StackPanel Name="Infos"></StackPanel>
            </ScrollViewer>
            <StackPanel Grid.Column="1">
                <Label Name="prodLabel" FontSize="20">Power Output: 0 MW</Label>
                <Label Name="demandLabel" FontSize="20">Demand: 0 MW</Label>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <StackPanel Orientation="Horizontal">
                    <Border BorderBrush="Blue" BorderThickness="2" CornerRadius="5" Margin="10">
                        <Grid>
                            <StackPanel Margin="10">
                                <Label>Coolant Panel</Label>
                                <CheckBox Name="CoolantValve">Coolant valve</CheckBox>
                                <CheckBox Name="Loop1">Loop 1 valve</CheckBox>
                                <CheckBox Name="Loop2">Loop 2 valve</CheckBox>
                                <Label>Filter select</Label>
                                <RadioButton GroupName="FilterGroup" Name="FilterA" IsChecked="True">Filter A</RadioButton>
                                <RadioButton GroupName="FilterGroup" Name="FilterB">Filter B</RadioButton>
                                <RadioButton GroupName="FilterGroup" Name="FilterOff">Bypass</RadioButton>
                                <CheckBox IsChecked="True">Oil separator</CheckBox>
                                <Button Name="CoolantTrip" Background="Red" Foreground="Yellow" HorizontalAlignment="Stretch" Click="CoolantTrip_OnClick">TRIP</Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border BorderBrush="Blue" BorderThickness="2" CornerRadius="5" Margin="10">
                        <Grid>
                            <StackPanel Margin="10">
                                <Label>Generator Panel</Label>
                                <CheckBox Name="GenPreheat" Click="GenPreheat_Checked">Generator preheat</CheckBox>
                                <CheckBox Name="GenCoolant" Click="GenCoolant_Checked">Gen coolant</CheckBox>
                                <Label Name="GenTemp">Stator Temperature: 30C</Label>
                                <ProgressBar Value="30" Maximum="120" Name="GenTempBar"></ProgressBar>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border BorderBrush="Blue" BorderThickness="2" CornerRadius="5" Margin="10">
                        <Grid>
                            <StackPanel Margin="10">
                                <Label>Hydraulic Panel</Label>
                                <CheckBox Name="ElecPump">Electric oil pump</CheckBox>
                                <CheckBox Name="FilterBypass">Filter bypass</CheckBox>
                                <Label Name="OilTemp">Oil Temperature: 15C</Label>
                                <ProgressBar Value="15" Maximum="100" Name="OilTempBar"></ProgressBar>
                                <CheckBox Name="OilCoolPump">Oil coolant pump</CheckBox>
                                <Label Name="FlowrateLabel">Flowrate: 0.2m³/s</Label>
                                <Slider Minimum="0.2" Maximum="2" Value="0.2" Name="Flowrate" ValueChanged="Flowrate_OnValueChanged"></Slider>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border BorderBrush="Blue" BorderThickness="2" CornerRadius="5" Margin="10">
                        <Grid>
                            <StackPanel Margin="10">
                                <Label>Turbine Panel</Label>
                                <CheckBox Name="Sync" IsEnabled="False" IsCheckedChanged="Sync_OnIsCheckedChanged">Sync to grid</CheckBox>
                                <Label Name="SyncStatus">Cant sync: too slow!</Label>
                                <CheckBox Name="Brake" IsChecked="True">Turbine brake</CheckBox>
                                <Label Name="RpmLabel">Turbine Speed: 0 rpm</Label>
                                <ProgressBar Maximum="300" Name="RpmBar"></ProgressBar>
                                <Label Name="WicketPositionLabel">Wicket gates: 0%</Label>
                                <Slider Minimum="0" Maximum="100" Value="0" Name="WicketGates" ValueChanged="WicketGates_OnValueChanged"></Slider>
                                <Button Name="WicketOpenFine" HorizontalAlignment="Stretch" Click="wicketOpenFine_Click">OPEN WICKET FINE</Button>
                                <Button Name="WicketCloseFine" HorizontalAlignment="Stretch" Click="wicketCloseFine_Click">CLOSE WICKET FINE</Button>
                                <Separator Height="1" Margin="0,10,0,10"></Separator>
                                <Button Name="TurbineFill" HorizontalAlignment="Stretch" Click="TurbineFill_Click">FILL TURBINE</Button>
                                <Button Name="MivOpen" HorizontalAlignment="Stretch" IsEnabled="False" Click="MIVopen_Click">OPEN MIV</Button>
                                <Separator Height="1" Margin="0,10,0,10"></Separator>
                                <Button Name="TurbineTrip" Background="Red" Foreground="Yellow" HorizontalAlignment="Stretch" Click="TurbineTrip_OnClick">TRIP</Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border BorderBrush="Blue" BorderThickness="2" CornerRadius="5" Margin="10">
                        <Grid>
                            <StackPanel Margin="10">
                                <Label>Lubrication</Label>
                                <CheckBox Name="LubPump" Content="Lubrication Pump"></CheckBox>
                                <CheckBox Name="Preheater" Content="Preheater"></CheckBox>
                                <CheckBox Name="Fan" Content="Fan"></CheckBox>
                                <Label Name="PumpStatus">Pump not running!</Label>
                                <Label Name="LubTemperature">Temperature: 20C</Label>
                                <ProgressBar Value="20" Maximum="50" Name="LubTempBar"></ProgressBar>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border BorderBrush="Blue" BorderThickness="2" CornerRadius="5" Margin="10">
                        <Grid>
                            <StackPanel Margin="10">
                                <Label>Others</Label>
                                <Button Name="ChangeFilterA" Click="ChangeFilterA_OnClick" HorizontalAlignment="Stretch">Change filter A</Button>
                                <Button Name="ChangeFilterB" Click="ChangeFilterB_OnClick" HorizontalAlignment="Stretch">Change filter B</Button>
                                <Separator Margin="10"></Separator>
                                <Label>Trash rack pressure:</Label>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
